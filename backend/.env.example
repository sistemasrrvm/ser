# ============================================
# CONFIGURAÇÕES DE AMBIENTE
# ============================================
# DESENVOLVIMENTO: Copie para .env e ajuste
# PRODUÇÃO (Railway): Configure via variáveis de ambiente do Railway
# ============================================

# Database
# Local (Windows): mysql+pymysql://root:1234@localhost/rrvm_laudonr13
# QA (Railway RRVM-SER-QA) — preencha MYSQL_* e monte DATABASE_URL:
# MYSQL_ENV=RRVM-SER-QA
# MYSQL_HOST=turntable.proxy.rlwy.net
# MYSQL_PORT=25797
# MYSQL_DB=railway
# MYSQL_USER=root
# MYSQL_PASSWORD=sua-senha-qa
# DATABASE_URL=mysql+pymysql://root:sua-senha-qa@turntable.proxy.rlwy.net:25797/railway
DATABASE_URL=mysql+pymysql://root:1234@localhost/rrvm_laudonr13

# JWT Configuration
# IMPORTANTE: Gerar chave aleatória em produção!
# Exemplo: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Password Reset
PASSWORD_RESET_TOKEN_EXPIRE_HOURS=1

# CORS
# Local: http://localhost:5173,http://127.0.0.1:5173
# Railway: https://seu-frontend.railway.app
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Application
APP_NAME=SER - Sistema de Emissão de Relatórios
APP_VERSION=1.0.0

# Environment
# Valores: development, production
ENVIRONMENT=development
DEBUG=True

# Port (Railway define automaticamente via $PORT)
PORT=8000

# SQL Server - Sistema NR13 (Sincronização de dados externos)
# IMPORTANTE: Estas variáveis são OPCIONAIS
# Se não configuradas, a sincronização será desabilitada
SQLSERVER_HOST=seu-servidor-sqlserver.com
SQLSERVER_PORT=1433
SQLSERVER_DATABASE=nome_do_banco_nr13
SQLSERVER_USER=usuario_readonly
SQLSERVER_PASSWORD=senha_segura
SQLSERVER_DRIVER=ODBC Driver 17 for SQL Server

# NR13 API Botset (#292) — carga de clientes/equipamentos
NR13_API_BASE_URL=https://bpm.api.botset.net/api/callback/RRVMNR13/RRVMNR13/cadastros
NR13_API_BASIC_USER=
NR13_API_BASIC_PASSWORD=
NR13_EQUIPAMENTO_TIPO=12
NR13_DATA_REF_DAYS_BACK=2
NR13_SYNC_CRON_SECRET=
NR13_API_TIMEOUT_SECONDS=120

# SMTP — notificações de fluxo de relatórios (#248)
# Produção RRVM: mail.rrvm.com.br:465, ser@rrvm.com.br (senha via UI ou env)
SMTP_HOST=
SMTP_PORT=465
SMTP_USE_SSL=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=SER - Sistema de Emissão de Relatórios
FRONTEND_URL=http://localhost:5173

# Exportação Excel — migração COM Windows
# excel_com = Microsoft Excel nativo (Windows, recomendado produção)
# openpyxl = fallback dev (templates complexos podem perder elementos)
# none = desabilitado (Railway/Linux)
# (vazio = auto: excel_com no Windows, none no Linux)
EXPORT_ENGINE=
EXCEL_COM_TIMEOUT_SECONDS=120
EXCEL_TEMP_DIR=
EXCEL_COM_VISIBLE=false
